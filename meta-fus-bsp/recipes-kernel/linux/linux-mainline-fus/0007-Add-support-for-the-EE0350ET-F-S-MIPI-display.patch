+	struct panel_nv3051d *ctx = panel_to_panelnv3051d(panel);
+	int ret;
+
+	dev_dbg(ctx->dev, "Resetting the panel\n");
+	ret = regulator_enable(ctx->vdd);
+	if (ret < 0) {
