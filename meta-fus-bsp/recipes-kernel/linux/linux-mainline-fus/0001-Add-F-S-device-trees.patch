+		gpio-line-names = 
+			/* 0-2 */ "BT_IRQ", "BT_HOST_WAKE",
+			/* 3-4 */ "BT_LED", "WLAN_LED", "WLAN_HOST_WAKE",
+			/* 5-6 */ "GPIO-EXP_GPIO1", "GPIO-EXP_GPIO2",
+			/* 7-8 */ "WLAN_WAKE_HOST", "BL_EN",
+			/* 9-10 */ "VLCD_EN", "VLCD_EN",
+			/* 11-12 */ "", "USB_OTG_PWR",
+			/* 13-14 */ "ETH_RST", "ETH_IRQ",
+			/* 15 */ "LVDS_CONV_STBY";
+		status = "okay";
+	};
+
+	tc358775@f {
