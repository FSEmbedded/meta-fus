+	pinctrl_tpm3: tpm3grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO24__TPM3_CH3		0x51e
+		>;
+	};
+#endif /* CONFIG_PICOCOREMX93_PWM_A */
+
+#ifdef CONFIG_PICOCOREMX93_BL_CTRL
+	pinctrl_tpm5: tpm5grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO18__TPM5_CH2		0x51e
+		>;
+	};
+#endif /* CONFIG_PICOCOREMX93_BL_CTRL */
+};
diff --git a/arch/arm64/boot/dts/F+S/soldercore8ulp-bbhd.dts b/arch/arm64/boot/dts/F+S/soldercore8ulp-bbhd.dts
new file mode 100644
index 000000000..bfe9d9898
--- /dev/null
+++ b/arch/arm64/boot/dts/F+S/soldercore8ulp-bbhd.dts
@@ -0,0 +1,25 @@
