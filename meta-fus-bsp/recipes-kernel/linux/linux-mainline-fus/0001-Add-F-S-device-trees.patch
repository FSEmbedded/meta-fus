+#define CONFIG_SOLDERCORE8ULP_USB1
+#define CONFIG_SOLDERCORE8ULP_EPDC
+#define CONFIG_SOLDERCORE8ULP_MIPI_DSI
+
+#include "soldercore8ulp.dtsi"
+
