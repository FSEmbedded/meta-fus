+			MX8ULP_PAD_PTF16__I2S4_TX_FS	0x43
+			MX8ULP_PAD_PTF17__I2S4_TXD0		0x43
+		>;
+	};
+#endif /* defined(CONFIG_PICOCOREMX8ULP_AUDIO_APD) */
+
+	pinctrl_vlcd: vlcdgrp {
+		fsl,pins = <
+			MX8ULP_PAD_PTF30__PTF30		0x2
+		>;
+	};
+};
+
