+/ {
+	model = "F&S PicoCoreMX8ULP";
+	compatible = "fus,picocoremx8ulp", "fus,fsimx8ulp", "fsl,imx8ulp";
+
+	chosen {
+		bootargs = "console=ttyLP0, 115200";
+		stdout-path = &fs_uart_a;
+	};
+
+	/delete-node/ aliases;
+	aliases {
+		ethernet0 = &fs_eth;
+		serial0 = &fs_uart_a;
+		serial1 = &fs_uart_b;
+		serial2 = &fs_uart_c;
+		i2c0 = &fs_i2c_int;
+		i2c1 = &fs_i2c_a;
+		i2c2 = &fs_i2c_b;
+		i2c3 = &fs_i2c_c;
+		i2c4 = &fs_i2c_d;
+		mmc0 = &emmc;
+		mmc1 = &fs_sdio_a;
+		gpio0 = &rp_gpioa;
+		gpio1 = &rp_gpiob;
+		gpio2 = &rp_gpioc;
+		gpio3 = &gpiod;
+		gpio4 = &gpioe;
+		gpio5 = &gpiof;
+		usbphy0 = &usbphy1;
+		usbphy1 = &usbphy2;
+		usb0 = &fs_usb_1;
+		usb1 = &fs_usb_2;
+		rtc0 = &ext_rtc;
+		isi0 = &isi_0;
+		csi0 = &mipi_csi0;
+		pwm0 = &fs_bl_pwm;
+		pwm1 = &fs_pwm;
+	};
