diff --git a/arch/arm64/boot/dts/F+S/displays/imx8mp-lcdif-adp-mipi2lvds1-j070wvtc0211-single-display.dtsi b/arch/arm64/boot/dts/F+S/displays/imx8mp-lcdif-adp-mipi2lvds1-j070wvtc0211-single-display.dtsi
