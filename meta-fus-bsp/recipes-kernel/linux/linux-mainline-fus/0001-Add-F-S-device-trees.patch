+		compatible = "maxim,max7315";
+#elif defined CONFIG_MIPI2LVDS1_TI_TCA9534
+		compatible = "nxp,pca9534";
+#endif
+		reg = <0x20>;
+		/* interrupt not yet supported */
+		//interrupt-parent = <&gpio4>;
+		//interrupts = <31 IRQ_TYPE_LEVEL_LOW>;
+		//#interrupt-cells = <2>;
+		//interrupt-controller;
+		gpio-controller;
+		#gpio-cells = <2>;
+#ifndef CONFIG_MIPI2LVDS1_TI_TCA9534
+		pwm-controller;
+#endif
+		#pwm-cells = <3>;
+		//#interrupt-cells = <2>;
+		//interrupt-controller;
+#ifdef CONFIG_MIPI2LVDS1_TI_TCA9534
+		bl-on {
+			gpio-hog;
+			gpios = <0 GPIO_ACTIVE_HIGH>;
+			gpio = <&ioexpander 0 GPIO_ACTIVE_HIGH>;
+			output-high;
+			line-name = "bl_on";
+		};
+		bl-pwm {
+			gpio-hog;
+			gpios = <1 GPIO_ACTIVE_HIGH>;
+			output-low;
+			line-name = "bl_pwm";
+		};
+#endif
+	};
+#endif
+	/* touch I2C */
+	focaltech@38 {
+		compatible = "focaltech,fts";
+		reg = <0x38>;
+		interrupt-parent = <&gpio5>;
+		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,irq-gpio = <&gpio5 2 IRQ_TYPE_EDGE_FALLING>;
