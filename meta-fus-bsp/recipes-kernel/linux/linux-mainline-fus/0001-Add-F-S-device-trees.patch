+		/* 0 = LVDS, 1 = MIPI, 2 = TTL */
+		rx-source = /bits/ 8 <1>;
+		/* optional: normally taken from simple panel display but can be
+		 * overwritten by bus-fmt flag: 6 = RGB666, 8 = RGB888
+		 */
