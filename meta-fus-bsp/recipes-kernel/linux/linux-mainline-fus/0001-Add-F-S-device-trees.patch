+&mipi_dsi {
+        status = "okay";
+        bus-fmt = <0x100a>;
+        port@1 {
+                reg = <1>;
+                dsim_to_lvds: endpoint {
+                        remote-endpoint = <&lvds_from_dsim>;
+                        data-lanes = <0 1 2 3>;
+                        attach-bridge;
+                };
+        };
