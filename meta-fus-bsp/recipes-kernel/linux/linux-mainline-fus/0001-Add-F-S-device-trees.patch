+
+		data-mapping = "vesa-24";
+		width-mm = <154>;
+		height-mm = <86>;
+
+		panel-timing {
+			clock-frequency = <33300000>;
+			hactive = <800>;
+			vactive = <480>;
+			hfront-porch = <210>;
+			hback-porch = <45>;
+			hsync-len = <1>;
+			vback-porch = <22>;
+			vfront-porch = <22>;
+			vsync-len = <1>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <0>;
+		};
+
+		port {
+			panel_lvds0_in: endpoint {
+				remote-endpoint = <&lvds0_out>;
+			};
+		};
+	};
+
+#ifdef CONFIG_EFUSMX8X_LVDS_DUAL_MODE
+	lvds1_panel {
+		compatible = "panel-lvds";
+#if 0
+		backlight = <&backlight>;
+#endif
+
+		data-mapping = "vesa-24";
+		width-mm = <154>;
+		height-mm = <86>;
+
+		panel-timing {
+			clock-frequency = <33300000>;
+			hactive = <800>;
+			vactive = <480>;
+			hfront-porch = <210>;
+			hback-porch = <45>;
+			hsync-len = <1>;
+			vback-porch = <22>;
+			vfront-porch = <22>;
+			vsync-len = <1>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <0>;
+		};
+
+		port {
+			panel_lvds1_in: endpoint {
+				remote-endpoint = <&lvds1_out>;
+			};
+		};
+	};
+#endif
+};
+
+&ldb1_phy {
+	status = "okay";
+};
+
+&ldb1 {
+	status = "okay";
+//	fsl,dual-channel;
+#if 0
+	TODO: Add Dual- and Split-Mode in imx-ldb.c (Split-Mode is more or less "fsl,dual-channel")
+	split-mode;
+	dual-mode;
+#endif
+//	power-domains = <&pd_mipi_dsi_0_dual_lvds>;
+
+	lvds-channel@0 {
+		reg = <0>;
+		fsl,data-mapping = "spwg";
+		fsl,data-width = <24>;
+#ifdef __LVDS0_PRIMARY__
+		primary;
+#endif
+		status = "okay";
+
+		port@1 {
+			reg = <1>;
+
+			lvds0_out: endpoint {
+				remote-endpoint = <&panel_lvds0_in>;
+			};
+		};
+	};
+};
+
+#ifdef CONFIG_EFUSMX8X_LVDS_DUAL_MODE
+&ldb2_phy {
+	status = "okay";
+};
+
+&ldb2 {
+	status = "okay";
+
+	lvds-channel@1 {
+		reg = <0>;
+		fsl,data-mapping = "spwg";
+		fsl,data-width = <24>;
+#ifdef __LVDS1_PRIMARY__
+		primary;
+#endif
+		status = "okay";
+
+		port@1 {
+			reg = <1>;
+
+			lvds1_out: endpoint {
+				remote-endpoint = <&panel_lvds1_in>;
+			};
+		};
+	};
+};
+#endif
+
+&i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+#ifdef CONFIG_EFUSMX8X_CAPTOUCH_MXT224
+	/* Atmel PCAP touch on Touch-Connector (I2C) */
+	mxt224@4a {
+		compatible = "atmel,maxtouch";
+		reg = <0x4a>;
+		interrupt-parent = <&lsio_gpio1>;
+		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
+		atmel,cfg_name = "atmel/mxt224.cfg";
+		atmel,reset-gpio = <&lsio_gpio1 1 GPIO_ACTIVE_LOW>;
+	};
+#endif
+
+#ifdef CONFIG_EFUSMX8X_CAPTOUCH_FT5x06
+	focaltech@38 {
+		compatible = "focaltech,fts";
+		reg = <0x38>;
+		interrupt-parent = <&lsio_gpio1>;
+		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,irq-gpio = <&lsio_gpio1 2 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,touchscreen-inverted-x;
+		focaltech,touchscreen-inverted-y;
+		focaltech,reset-gpio = <&lsio_gpio1 1 GPIO_ACTIVE_LOW>;
+		focaltech,num-max-touches = <10>;
+		focaltech,display-coords = <0 0 800 480>;
+	};
+#endif
+};
diff --git a/arch/arm64/boot/dts/F+S/efusmx8x-lcdif-rgt070qyh-13cp.dts b/arch/arm64/boot/dts/F+S/efusmx8x-lcdif-rgt070qyh-13cp.dts
new file mode 100644
index 000000000..970609252
--- /dev/null
+++ b/arch/arm64/boot/dts/F+S/efusmx8x-lcdif-rgt070qyh-13cp.dts
@@ -0,0 +1,189 @@
+/*
+ * Copyright (C) 2019-2020 F&S Elektronik Systeme GmbH
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+/dts-v1/;
+
+#define CONFIG_EFUSMX8X_MIPI_DSI
+#define CONFIG_EFUSMX8X_CAPTOUCH_FT5x06
+
+#include "efusmx8x.dts"
+
+/ {
+	regulators {
+		reg_mipi_bl: backlight_mipi {
+			compatible = "regulator-fixed";
+			regulator-name = "mipi-bl";
+			gpio = <&pca963x 0 0>;
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			enable-active-high;
+		};
+	};
+
+	backlight_mipi_dsi: backlight_mipi_dsi {
+		compatible = "pwm-backlight";
+		pwms = <&pca963x 1 640000 PWM_POLARITY_INVERTED>;
+		power-supply = <&reg_mipi_bl>;
+		brightness-levels = <0 1 5 10 18 28 41 56
+				     73 92 113 137 163 192 222 255>;
+		default-brightness-level = <13>;
+	};
+};
+
+&mipi0_dphy {
+	status = "okay";
+};
+
+&mipi0_dsi_host {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	mipi0_panel {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+		compatible = "rongen,t070qyh-13cp";
+		reset-gpios = <&pca963x 3 GPIO_ACTIVE_LOW>;
+		reg = <0>;
+		dsi-lanes = <4>;
+		/* Video mode
+		 * 0: burst mode
+		 * 1: non-burst mode with sync event
+		 * 2: non-burst mode with sync pulse
+		 */
+		video-mode = <0>;
+		panel-width-mm = <94>;
+		panel-height-mm = <150>;
+
+		display-timings {
+			timing {
+				clock-frequency = <72000000>;
+				hactive = <800>;
+				vactive = <1280>;
+				hback-porch = <72>;
+				hfront-porch = <56>;
+				vback-porch = <38>;
+				vfront-porch = <3>;
+				hsync-len = <128>;
+				vsync-len = <10>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+
+		port@0 {
+			reg = <0>;
+			panel_mipi0_in: endpoint {
+				remote-endpoint = <&mipi0_out>;
+			};
+		};
+	};
+
+	ports {
+		port@1 {
+			reg = <1>;
+			mipi0_out: endpoint {
+				remote-endpoint = <&panel_mipi0_in>;
+			};
+		};
+	};
+};
+
+&i2c0_mipi_lvds0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	pca963x: pca9634@61 {
+			compatible = "nxp,pca9634";
+			reg = <0x61>;
+			nxp,totem-pole;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#pwm-cells = <3>;
+			#gpio-cells = <2>;
+			led@0 {
+				reg = <0>;
+				label = "BL_ON";
+				type = "GPIO";
+				active-high;
+				default-on;		/* or: keep-value */
+			};
+			led@1 {
+				reg = <1>;
+				label = "BL_PWM";
+				type = "PWM";
+				active-high;
+			};
+			led@2 {
+				reg = <2>;
+				label = "2-unused";
+				type = "LED";
+				active-low;
+			};
+			led@3 {
+				reg = <3>;
+				label = "MIPI_RST";
+				type = "GPIO";
+				active-high;
+				default-on;		/* or: keep-value */
+			};
+			led@4 {
+				reg = <4>;
+				label = "4-unused";
+				type = "LED";
+				active-low;
+			};
+			led@5 {
+				reg = <5>;
+				label = "TOUCH_RST";
+				type = "GPIO";
+				active-high;
+				default-on;		/* or: keep-value */
+			};
+			led@6 {
+				reg = <6>;
+				label = "6-unused";
+				type = "LED";
+				active-low;
+			};
+			led@7 {
+				reg = <7>;
+				label = "7-unused";
+				type = "LED";
+				active-low;
+			};
+		};
+
+	/* touch I2C */
+	focaltech@38 {
+		compatible = "focaltech,fts";
+		reg = <0x38>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_touch>;
+		interrupt-parent = <&lsio_gpio1>;
+		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,irq-gpio = <&lsio_gpio1 2 IRQ_TYPE_EDGE_FALLING>;
+		focaltech,swap-xy;
+		focaltech,touchscreen-inverted-y;
+		focaltech,reset-gpio = <&lsio_gpio1 1 GPIO_ACTIVE_LOW>;
+		focaltech,num-max-touches = <10>;
+		focaltech,display-coords = <0 0 800 1280>;
+	};
+};
+
+&iomuxc {
+		pinctrl_touch: touch_grp {
+			fsl,pins = <
+				IMX8QXP_MIPI_DSI0_GPIO0_01_LSIO_GPIO1_IO28 0xc6000020
+			>;
+		};
+};
diff --git a/arch/arm64/boot/dts/F+S/efusmx8x.dts b/arch/arm64/boot/dts/F+S/efusmx8x.dts
new file mode 100644
index 000000000..e9fb85d62
--- /dev/null
+++ b/arch/arm64/boot/dts/F+S/efusmx8x.dts
@@ -0,0 +1,1458 @@
+/*
+ * Copyright (C) 2019-2020 F&S Elektronik Systeme GmbH
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+/dts-v1/;
+
+/* Set board revision as 3-digit number, e.g. 110 for board rev. 1.10 */
+#define CONFIG_EFUSMX8X_BOARD_REVISION	110
+
+/* On-board NAND */
+#define CONFIG_EFUSMX8X_NAND
+
+/* On-board eMMC */
+#define CONFIG_EFUSMX8X_EMMC
+
+#define CONFIG_EFUSMX8X_ADC
+
+#define CONFIG_EFUSMX8X_CAN_A
+#define CONFIG_EFUSMX8X_CAN_B
+
+#define CONFIG_EFUSMX8X_ETH0
+#define CONFIG_EFUSMX8X_ETH1
+
+#define CONFIG_EFUSMX8X_I2C_A
+#define CONFIG_EFUSMX8X_I2C_B
+#define CONFIG_EFUSMX8X_I2C_C
+
+#define CONFIG_EFUSMX8X_AUDIO
+
+#define CONFIG_EFUSMX8X_PWM_A /* BL_CTRL */
+//#define CONFIG_EFUSMX8X_PWM_B /* I2C_B_CLK */
+
+#define CONFIG_EFUSMX8X_SD_A
+#define CONFIG_EFUSMX8X_SD_A_CD
+#define CONFIG_EFUSMX8X_SD_A_WP
+
+#define CONFIG_EFUSMX8X_SPI_A
+#define CONFIG_EFUSMX8X_SPI_B
+
+#define CONFIG_EFUSMX8X_UART_A
+#define CONFIG_EFUSMX8X_UART_B
+#define CONFIG_EFUSMX8X_UART_B_RTSCTS
+#define CONFIG_EFUSMX8X_UART_C
+#define CONFIG_EFUSMX8X_UART_C_RTSCTS
+#define CONFIG_EFUSMX8X_UART_D
+
+#define CONFIG_EFUSMX8X_USB_OTG
+#define CONFIG_EFUSMX8X_USB_HOST
+
+#define CONFIG_EFUSMX8X_WLAN
+
+/* If SD_A is not used, remove CD and WP */
+#ifndef CONFIG_EFUSMX8X_SD_A
+#undef CONFIG_EFUSMX8X_SD_A_CD
+#undef CONFIG_EFUSMX8X_SD_A_WP
+#endif
+
+/* If UART_B not used, remove RTS/CTS */
+#ifndef CONFIG_EFUSMX8X_UART_B
+#undef CONFIG_EFUSMX8X_UART_B_RTSCTS
+#endif
+
+/* If UART_C not used, remove RTS/CTS */
+#ifndef CONFIG_EFUSMX8X_UART_C
+#undef CONFIG_EFUSMX8X_UART_C_RTSCTS
+#endif
+
+/* PWM_B is on I2C_B_CLK and can only be used if I2C_B is disabled */
+#ifdef CONFIG_EFUSMX8X_PWM_B
+#undef CONFIG_EFUSMX8X_I2C_B
+#endif
+
+#include "../freescale/imx8qxp.dtsi"
+#include <dt-bindings/pwm/pwm.h>
+#include <dt-bindings/rtc/nxp,pcf85263.h>
+
+/ {
+    model = "F&S efusMX8X";
+	compatible = "fus,imx8qxp-efusmx8x", "fsl,imx8qxp";
+
+	chosen {
+		stdout-path = &lpuart2;
+	};
+
+	aliases {
+		/* NXP sets i2c_rpmsg as aliases, so set the i2c order explicitly */
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x00000000 0x80000000 0 0x40000000>;
+	};
+
+	resmem: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * 0x8800_0000 ~ 0x8FFF_FFFF is reserved for M4
+		 * Shouldn't be used at A core and Linux side.
+		 *
+		 */
+		m4_reserved: m4@88000000 {
+			no-map;
+			reg = <0 0x88000000 0 0x8000000>;
+		};
+
+		rpmsg_reserved: rpmsg@90000000 {
+			no-map;
+			reg = <0 0x90200000 0 0x200000>;
+		};
+
+		decoder_boot: decoder-boot@84000000 {
+			reg = <0 0x84000000 0 0x2000000>;
+			no-map;
+		};
+
+		encoder_boot: encoder-boot@86000000 {
+			reg = <0 0x86000000 0 0x200000>;
+			no-map;
+		};
+
+		decoder_rpc: decoder-rpc@92000000 {
+			reg = <0 0x92000000 0 0x200000>;
+			no-map;
+		};
+
+		encoder_rpc: encoder-rpc@92200000 {
+			reg = <0 0x92200000 0 0x200000>;
+			no-map;
+		};
+		encoder_reserved: encoder_reserved@94400000 {
+			no-map;
+			reg = <0 0x94400000 0 0x800000>;
+		};
+		/* global autoconfigured region for contiguous allocations */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0 0x14000000>;
+			alloc-ranges = <0 0x96000000 0 0x14000000>;
+			linux,cma-default;
+			/*
+			 * The propertiy "size" is overwritten by UBoot,
+			 * depending on the ram size. To prevent this,
+			 * uncomment the following line
+			 */
+			no-uboot-override;
+		};
+	};
+
+	imx8x_cm4: imx8x_cm4@0 {
+		compatible = "fsl,imx8qxp-cm4";
+		rsc-da = <0x90000000>;
+		mbox-names = "tx", "rx", "rxdb";
+		mboxes = <&lsio_mu5 0 1
+			  &lsio_mu5 1 1
+			  &lsio_mu5 3 1>;
+		mub-partition = <3>;
+		memory-region = <&vdev0vring0>, <&vdev0vring1>, <&vdevbuffer>,
+				<&vdev1vring0>, <&vdev1vring1>;
+		core-index = <0>;
+		core-id = <IMX_SC_R_M4_0_PID0>;
+		status = "okay";
+		power-domains = <&pd IMX_SC_R_M4_0_PID0>,
+				<&pd IMX_SC_R_M4_0_MU_1A>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		vdev0vring0: vdev0vring0@90000000 {
+                        compatible = "shared-dma-pool";
+			reg = <0 0x90000000 0 0x8000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@90008000 {
+                        compatible = "shared-dma-pool";
+			reg = <0 0x90008000 0 0x8000>;
+			no-map;
+		};
+
+		vdev1vring0: vdev1vring0@90010000 {
+                        compatible = "shared-dma-pool";
+			reg = <0 0x90010000 0 0x8000>;
+			no-map;
+		};
+
+		vdev1vring1: vdev1vring1@90018000 {
+                        compatible = "shared-dma-pool";
+			reg = <0 0x90018000 0 0x8000>;
+			no-map;
+		};
+
+		rsc-table {
+			reg = <0 0x900ff000 0 0x1000>;
+			no-map;
+		};
+
+		vdevbuffer: vdevbuffer {
+                        compatible = "shared-dma-pool";
+			reg = <0 0x90400000 0 0x100000>;
+			no-map;
+		};
+	};
+
+	regulators {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		reg_module_3v3: regulator-module-3v3 {
+			compatible = "regulator-fixed";
+			regulator-name = "+V3.3";
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-always-on;
+		};
+
+		reg_module_3v0_avdd: regulator-module-3v0-avdd {
+			compatible = "regulator-fixed";
+			regulator-name = "+V3.0_AUDIO";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+			regulator-always-on;
+		};
+
+		reg_vref_1v8: regulator-vref-1v8 {
+			compatible = "regulator-fixed";
+			regulator-name = "+V1.8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
+		reg_vref_1v5: regulator-vref-1v5 {
+			compatible = "regulator-fixed";
+			regulator-name = "+V1.5";
+			regulator-min-microvolt = <1500000>;
+			regulator-max-microvolt = <1500000>;
+			regulator-always-on;
+		};
+#ifdef CONFIG_EFUSMX8X_LVDS
+		reg_ldb_bl: backlight_ldb { /* VCFL */
+			compatible = "regulator-fixed";
+			regulator-name = "ldb-bl";
+			gpio = <&lsio_gpio3 24 0>;
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			enable-active-high;
+		};
+#endif
+#ifdef CONFIG_EFUSMX8X_MIPI_DSI
+		reg_mipi_bl: backlight_mipi { /* VCFL */
+			compatible = "regulator-fixed";
+			regulator-name = "mipi-bl";
+			gpio = <&lsio_gpio3 24 0>;
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			enable-active-high;
+		};
+#endif
+		/* LCD power on voltage */
+		reg_vlcd: vlcd { /* VLCD_ON */
+			compatible = "regulator-fixed";
+			regulator-name = "VLCD";
+			gpio = <&lsio_gpio1 30 0>;
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			enable-active-high;
+			regulator-always-on;
+		};
+	};
+
+#ifdef CONFIG_EFUSMX8X_AUDIO
+	sound-sgtl5000 {
+		compatible = "fsl,imx-audio-sgtl5000";
+		model = "imx-sgtl5000";
+		cpu-dai = <&sai0>;
+		audio-codec = <&sgtl5000>;
+		audio-routing =
+			"LINE_IN", "Line In Jack",
+//###			"MIC_IN", "Mic Jack",
+//###			"Line Out Jack", "LINE_OUT",
+			"Headphone Jack", "HP_OUT";
+	};
+#endif
+
+	/* F&S board information */
+	bdinfo: bdinfo {
+		compatible = "bdinfo";
+	};
+};
+
+&acm {
+	status = "okay";
+};
+
+#ifdef CONFIG_EFUSMX8X_ADC
+&adc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_adc0>;
+	vref-supply = <&reg_vref_1v8>;
+	status = "okay";
+};
+#endif
+
+&amix {
+	status = "disabled";
+};
+
+&asrc0 {
+	fsl,asrc-rate  = <48000>;
+	status = "okay";
+};
+
+&asrc1 {
+	fsl,asrc-rate = <48000>;
+	status = "okay";
+};
+
+#ifdef CONFIG_EFUSMX8X_AUDIO
+&sai0 {
