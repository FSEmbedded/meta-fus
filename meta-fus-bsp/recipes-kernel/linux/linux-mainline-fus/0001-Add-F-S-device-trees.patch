index 000000000..ced406f54
--- /dev/null
+++ b/arch/arm64/boot/dts/F+S/displays/imx8mp-lcdif-adp-mipi2lvds1-j070wvtc0211-single-display.dtsi
@@ -0,0 +1,119 @@
+/*
+ * Copyright (C) 2019 F&S Elektronik Systeme GmbH
+ *
