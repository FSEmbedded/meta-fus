From: Philipp Gerbach <gerbach@fs-net.de>
Date: Fri, 18 Jul 2025 12:37:11 +0200
Subject: [PATCH 2/7] Add the F&S gpmi-nand driver

i.MX6 F&S Boards use the gpmi-fus driver, which introduces a own NAND
layout. To be able compliant with older U-boots we have to stick to this
layout. For this we also need a F&S specific dma driver.
---
 drivers/dma/Kconfig                           |    9 +
 drivers/dma/Makefile                          |    1 +
 drivers/dma/mxs-dma-ext.c                     |  895 ++++++
 drivers/mtd/nand/raw/Kconfig                  |    7 +
 drivers/mtd/nand/raw/gpmi-nand/Makefile       |    2 +
 drivers/mtd/nand/raw/gpmi-nand/bch-regs.h     |   20 +-
 .../mtd/nand/raw/gpmi-nand/gpmi-nand-fus.c    | 2843 +++++++++++++++++
 drivers/mtd/nand/raw/gpmi-nand/gpmi-nand.h    |    7 +-
 drivers/mtd/nand/raw/nand_base.c              |  389 +--
 drivers/mtd/nand/raw/nand_bbt.c               |    4 +-
 include/linux/mtd/mtd.h                       |    3 +-
 include/linux/mtd/rawnand.h                   |    5 +
 include/linux/mxs-dma-ext.h                   |   60 +
 13 files changed, 4046 insertions(+), 199 deletions(-)

diff --git a/drivers/dma/Kconfig b/drivers/dma/Kconfig
index d9ec1e69e..fa4af20c2 100644
--- a/drivers/dma/Kconfig
+++ b/drivers/dma/Kconfig
@@ -506,6 +506,15 @@ config MXS_DMA
 	  Support the MXS DMA engine. This engine including APBH-DMA
 	  and APBX-DMA is integrated into some Freescale chips.
 
+config MXS_DMA_EXT
+	bool "Extended MXS DMA support"
+	depends on SOC_IMX23 || SOC_IMX28 || SOC_IMX6
+	select STMP_DEVICE
+	select DMA_ENGINE
+	help
+	  Use the extended version of the MXS DMA engine to have better
+	  GPMI NAND support on i.MX6.
+
 config NBPFAXI_DMA
 	tristate "Renesas Type-AXI NBPF DMA support"
 	select DMA_ENGINE
