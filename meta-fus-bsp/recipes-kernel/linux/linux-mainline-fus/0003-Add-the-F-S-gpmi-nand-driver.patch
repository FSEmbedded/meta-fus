diff --git a/drivers/mtd/nand/raw/gpmi-nand/gpmi-nand-fus.c b/drivers/mtd/nand/raw/gpmi-nand/gpmi-nand-fus.c
new file mode 100644
index 000000000..4b29cb4f0
--- /dev/null
+++ b/drivers/mtd/nand/raw/gpmi-nand/gpmi-nand-fus.c
@@ -0,0 +1,2843 @@
+/*
