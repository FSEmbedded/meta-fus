+#else
+#define CONFIG_ARMSTONEA9_LVDS1_BPP	32
+#define CONFIG_ARMSTONEA9_LVDS1_PIX_FMT	"RGB666"
+#define CONFIG_ARMSTONEA9_LVDS1_DATA_WIDTH	18
+#define CONFIG_ARMSTONEA9_LVDS1_MAPPING	"spwg"
