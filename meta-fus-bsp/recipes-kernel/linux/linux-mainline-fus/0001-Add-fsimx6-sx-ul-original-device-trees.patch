+#if (((CONFIG_NETDCUA9_MXCFB0 == DISPLAY_LCD) \
+      || (CONFIG_NETDCUA9_MXCFB0 == DISPLAY_BT656)) \
+     && (CONFIG_NETDCUA9_MXCFB1 == DISPLAY_LVDS0))
