+#endif
+
+/*
+ * Configure LVDS1 settings here (ignored if LVDS1 is not used)
+ * For mapping value see above.
+ */
+#ifndef DISPLAY_LVDS_CHIMEI
+#define CONFIG_QBLISSA9_LVDS1_BPP	32
