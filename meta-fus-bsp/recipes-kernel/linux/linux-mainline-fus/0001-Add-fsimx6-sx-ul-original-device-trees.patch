diff --git a/arch/arm/boot/dts/fus/gar2.dts b/arch/arm/boot/dts/fus/gar2.dts
new file mode 100644
index 000000000..d736690d9
--- /dev/null
+++ b/arch/arm/boot/dts/fus/gar2.dts
@@ -0,0 +1,563 @@
+/*
