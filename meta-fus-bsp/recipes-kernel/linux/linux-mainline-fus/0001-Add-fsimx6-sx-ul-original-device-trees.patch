+		interrupt-parent = <&gpio3>;
+		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
+		rcr_val = <0x40>;
+		dcr_val = <0x1>;
+		gpoc_val = <0x19>;
+		wordlength = <2>;
+		mac-from-dev;
+
+		fsl,weim-cs-timing = <0x00020001 0x00000000 0x16000202
+					0x00000002 0x16002082 0x00000000>;
+	};
