+				MX6UL_PAD_UART3_CTS_B__GPIO1_IO26	0x000b0
+				MX6UL_PAD_LCD_DATA04__GPIO3_IO09	0x000b0
+				MX6UL_PAD_LCD_DATA05__GPIO3_IO10	0x000b0
+				/* USB_OTG1 Power on/off based on customers' demand using
