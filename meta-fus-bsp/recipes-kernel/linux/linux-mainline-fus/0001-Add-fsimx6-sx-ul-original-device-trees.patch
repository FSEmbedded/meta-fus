+			regulator-max-microvolt = <3300000>;
+			regulator-always-on;
+		};
+
+		/* USB_H1_PWR/USB_OTG_PWR are always on, no regulator needed */
+#if 0 //###
+		reg_usb_vbus: usb_vbus {
