+				MX6QDL_PAD_SD3_DAT3__SD3_DATA3		0x17091
+				MX6QDL_PAD_SD3_DAT4__SD3_DATA4		0x17091
+				MX6QDL_PAD_SD3_DAT5__SD3_DATA5		0x17091
+				MX6QDL_PAD_SD3_DAT6__SD3_DATA6		0x17091
+				MX6QDL_PAD_SD3_DAT7__SD3_DATA7		0x17091
+				/* Reset eMMC, active low */
+				MX6QDL_PAD_SD3_RST__SD3_RESET		0x17091
+			>;
+		};
+#endif
+
+		/* Internal I2C, always active */
+		pinctrl_i2c1: i2c1grp {
+			fsl,pins = <
+				MX6QDL_PAD_CSI0_DAT8__I2C1_SDA		0x4001b8b1
+				MX6QDL_PAD_CSI0_DAT9__I2C1_SCL		0x4001b8b1
+			>;
+		};
+
+#ifdef CONFIG_QBLISSA9R2_I2C_A
+		pinctrl_i2c3: i2c3grp-1 {
+			fsl,pins = <
+				MX6QDL_PAD_GPIO_3__I2C3_SCL		0x4001b8b1
+				MX6QDL_PAD_GPIO_16__I2C3_SDA		0x4001b8b1
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_I2C_B
+		pinctrl_i2c2: i2c2grp {
+			fsl,pins = <
+				MX6QDL_PAD_KEY_COL3__I2C2_SCL		0x4001b8b1
+				MX6QDL_PAD_KEY_ROW3__I2C2_SDA		0x4001b8b1
+				/* IRQ */
+				MX6QDL_PAD_ENET_TXD0__GPIO1_IO30	0x17000
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_I2C_C
+		pinctrl_i2c_gpio_c: i2c_gpio_c_grp {
+			fsl,pins = <
+				MX6QDL_PAD_SD4_DAT6__GPIO2_IO14		0x070b1
+				MX6QDL_PAD_SD4_DAT7__GPIO2_IO15		0x070b1
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_I2C_D
+		pinctrl_i2c_gpio_d: i2c_gpio_d_grp {
+			fsl,pins = <
+				MX6QDL_PAD_DISP0_DAT14__GPIO5_IO08	0x070b1
+				MX6QDL_PAD_DISP0_DAT15__GPIO5_IO09	0x070b1
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_HDMI
+		pinctrl_i2c_gpio_hdmi: i2c6_gpio_hdmi_grp {
+			fsl,pins = <
+				MX6QDL_PAD_DISP0_DAT16__GPIO5_IO10	0x03039
+				MX6QDL_PAD_DISP0_DAT17__GPIO5_IO11	0x03039
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_SERIAL_CAMERA
+		pinctrl_i2c_gpio_cam1: i2c_gpio_cam1_grp {
+			fsl,pins = <
+				MX6QDL_PAD_CSI0_DAT14__GPIO6_IO00	0x07048
+				MX6QDL_PAD_CSI0_DAT15__GPIO6_IO01	0x07048
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_PWM_A
+		pinctrl_pwm3: pwm3grp {
+			fsl,pins = <
+				MX6QDL_PAD_SD4_DAT1__PWM3_OUT		0x110b0
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_PWM_B
+		pinctrl_pwm4: pwm4grp {
+			fsl,pins = <
+				MX6QDL_PAD_SD4_DAT2__PWM4_OUT		0x110b0
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_PWM_C
+		pinctrl_pwm1: pwm1grp {
+			fsl,pins = <
+				MX6QDL_PAD_DISP0_DAT8__PWM1_OUT		0x110b0
+			>;
+		};
+#endif
+
+#ifdef CONFIG_QBLISSA9R2_PCIE
+		pinctrl_pcie: pciegrp {
+			fsl,pins = <
+				/* PCIE_WAKE */
+				MX6QDL_PAD_NANDF_CS3__GPIO6_IO16	0x1b0b0
+				/* PCIE_RST: see above in Hog */
+			>;
+		};
+#endif /* CONFIG_QBLISSA9R2_PCIE */
+
+#ifdef CONFIG_QBLISSA9R2_HDMI_CEC
+		pinctrl_hdmi_cec_1: hdmicecgrp {
+			fsl,pins = <
+				MX6QDL_PAD_EIM_A25__HDMI_TX_CEC_LINE	0x1f8b0
+			>;
+		};
+#endif /* CONFIG_QBLISSA9R2_HDMI_CEC */
+
+		pinctrl_status_leds: ledgrp {
+			fsl,pins = <
+				MX6QDL_PAD_GPIO_17__GPIO7_IO12		0x80000000
+				MX6QDL_PAD_GPIO_18__GPIO7_IO13		0x80000000
+			>;
+		};
+	};
+};
