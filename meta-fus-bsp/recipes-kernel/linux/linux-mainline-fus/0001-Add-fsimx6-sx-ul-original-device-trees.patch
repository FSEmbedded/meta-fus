+ * other to PLL5. If you have activated the displays in U-Boot already and want
+ * to keep these settings in Linux, de-activate all four lines.
+ */
+//#define CONFIG_NETDCUA9_LVDS0_CLK  IMX6QDL_CLK_PLL2_PFD0_352M
