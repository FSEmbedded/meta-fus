+/* AUDIO */
+#define CONFIG_QBLISSA9_WM9715_AUDIO
+
+/* WLAN/BLUETOOTH */
+//#define CONFIG_QBLISSA9_WLAN
+//#define CONFIG_QBLISSA9_BLUETOOTH
