+	hsync-len = <1>;		\
+	vback-porch = <22>;		\
+	vfront-porch = <22>;		\
+	vsync-len = <1>;		\
+	hsync-active = <0>;		\
+	vsync-active = <0>;		\
+	de-active = <1>;		\
+	pixelclk-active = <0>;		\
