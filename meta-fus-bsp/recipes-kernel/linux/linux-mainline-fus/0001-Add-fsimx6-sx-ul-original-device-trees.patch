+#ifndef CONFIG_ARMSTONEA9_PARALLEL_CAMERA
+/*
+ * CKO is shared for Audio and Camera. So if camera is in use, we output
+ * 24 MHz on CKO and use audio codec PLL to create bit clock. If camera is not
+ * in use, we can output 12.288 MHz which is better suited for audio bit clock
+ * because it avoids the need for the codec PLL in most cases.
+ *
+ * Remark:
+ * The version below internally uses CKO2 to create signal CKO. If we ever
+ * need CKO2 elsewhere, there is a different way with just CKO1 but with a
+ * restriction to 24.576 MHz on Dual/Quad. See netdcua9qdl.dtsi/efusa9qdl.dtsi.
+ */
+&clks {
+	assigned-clocks =
+#ifdef CONFIG_ARMSTONEA9_LVDS0_CLK
+			  <&clks IMX6QDL_CLK_LDB_DI0_SEL>,
+#endif
+#ifdef CONFIG_ARMSTONEA9_LVDS1_CLK
+			  <&clks IMX6QDL_CLK_LDB_DI1_SEL>,
+#endif
+			  <&clks IMX6QDL_CLK_PLL4_AUDIO_DIV>,
+			  <&clks IMX6QDL_CLK_SSI1_SEL>,
+			  <&clks IMX6QDL_CLK_SSI1>,
+			  <&clks IMX6QDL_CLK_CKO2_SEL>,
+			  <&clks IMX6QDL_CLK_CKO>;
+
+	assigned-clock-parents =
+#ifdef CONFIG_ARMSTONEA9_LVDS0_CLK
+				 <&clks CONFIG_ARMSTONEA9_LVDS0_CLK>,
+#endif
+#ifdef CONFIG_ARMSTONEA9_LVDS1_CLK
+				 <&clks CONFIG_ARMSTONEA9_LVDS1_CLK>,
+#endif
+				 <0>,
+				 <&clks IMX6QDL_CLK_PLL4_AUDIO_DIV>,
+				 <0>,
+				 <&clks IMX6QDL_CLK_SSI1>,
+				 <&clks IMX6QDL_CLK_CKO2>;
+
+	assigned-clock-rates =
+#ifdef CONFIG_ARMSTONEA9_LVDS0_CLK
+				<0>,
+#endif
+#ifdef CONFIG_ARMSTONEA9_LVDS1_CLK
+				<0>,
+#endif
+				<786432000>,
+				<0>,
+#ifdef CONFIG_ARMSTONEA9_AUDIO_12M288
+				<12288000>,	/* Audio with 12.288 MHz */
+#else
+				<24576000>,	/* Audio with 24.576 MHz */
+#endif
+				<0>;
+};
+#endif
